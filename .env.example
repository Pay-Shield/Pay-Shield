# Required — no hardcoded fallback. Get this from MongoDB Atlas: your cluster
# -> Connect -> Drivers -> Node.js. Must include your own DB user's password.
MONGODB_URI=

# Optional — falls back to a shared test-sandbox key/secret if unset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — these already match the defaults used if unset.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
